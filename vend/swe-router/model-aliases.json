{
  "schema_version": "1.0",
  "note": "Maps the model slugs in models.json to the names coding assistants actually show or accept. One slug, many surfaces: a Bedrock inference profile, a vendor API id, a provider-prefixed id, and whatever a dropdown displays. Matching is case-insensitive; compare after lowercasing and stripping spaces, underscores and hyphens. If nothing matches exactly, fall back to substring and then ask the user.",
  "matching_rules": [
    "Lowercase both sides, then strip spaces, underscores and hyphens before comparing.",
    "A trailing bracketed hint such as [1m] is a context-window marker, not part of the id. Strip it.",
    "A leading region and vendor prefix such as us.anthropic. or eu.meta. is routing, not identity. Strip it.",
    "A trailing date-and-version stamp such as -20251001-v1:0 identifies a snapshot of the same model. Strip it.",
    "A provider prefix before a slash, such as anthropic/ or bedrock/, is routing. Strip it.",
    "Match exactly first. Only if that fails, try substring. Never guess between two candidates -- ask."
  ],
  "unmatched_model_policy": "A model the user has that is absent from models.json has NOT been measured. Say so and leave it out of the ranking. Never estimate a score for it.",
